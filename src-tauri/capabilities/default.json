{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Manager and floating pet window permissions.",
  "windows": ["main", "pet"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:event:allow-emit",
    "core:event:allow-listen"
  ]
}
